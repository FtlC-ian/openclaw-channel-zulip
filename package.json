{
  "name": "openclaw-channel-zulip",
  "version": "2026.10.9",
  "description": "Zulip channel plugin for OpenClaw — concurrent message processing, file uploads, approval hooks, and native message actions",
  "type": "module",
  "author": "FtlC-ian",
  "license": "MIT",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "openclaw-channel",
    "zulip",
    "chatbot",
    "bot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FtlC-ian/openclaw-channel-zulip.git"
  },
  "homepage": "https://github.com/FtlC-ian/openclaw-channel-zulip#readme",
  "bugs": {
    "url": "https://github.com/FtlC-ian/openclaw-channel-zulip/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "docs/ACTION_CAPABILITIES.md",
    "docs/APPROVAL_REACTIONS.md",
    "docs/LIFECYCLE.md",
    "docs/POLICY_ADAPTERS.md",
    "docs/RELEASE_CHECKLIST.md",
    "docs/TOPIC_MIGRATION.md",
    "docs/UNICODE-NOTICE.txt",
    "scripts/migrate-topic-sessions.mjs",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/sync-plugin-manifest.mjs --check && node scripts/check-sdk-exports.mjs",
    "sdk:check": "node scripts/check-sdk-exports.mjs",
    "manifest:sync": "tsc && node scripts/sync-plugin-manifest.mjs",
    "manifest:check": "tsc && node scripts/sync-plugin-manifest.mjs --check",
    "prepack": "npm run build",
    "test": "vitest run src && node --test scripts/migrate-topic-sessions.test.mjs scripts/check-sdk-exports.test.mjs",
    "prepublishOnly": "npm run build",
    "test:hosts": "node --test scripts/approval-host-smoke.test.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "openclaw": "2026.9.6",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "zulip",
      "label": "Zulip",
      "selectionLabel": "Zulip (plugin)",
      "docsLabel": "zulip",
      "blurb": "Zulip streams/topics with native session conversation binding and approval hooks (plugin, installed separately).",
      "order": 70
    },
    "install": {
      "npmSpec": "openclaw-channel-zulip",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.9.3"
    }
  }
}
